{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:headers": "CASAGAD_HEADERS_TEST=1 vitest run tests/integration/headers.test.ts",
    "test:rules": "vitest run --passWithNoTests tests/rules",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "i18next": "~27.2.7",
    "next": "~16.4.6",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-i18next": "~18.0.3",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "firebase-tools": "^15.37.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "re2@1.27.2": true,
    "protobufjs@7.6.6": true,
    "@firebase/util@1.15.3": true,
    "fsevents@2.3.3": true
  }
}

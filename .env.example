# Names only. No values in this file.
# Local values go in .env.local (gitignored). Patricia sets them. Never commit .env.local.
# Production secrets go in Google Secret Manager. Production public config is set in the App Hosting console.

# Public Firebase web config. Identifiers, not secrets. The client uses these when FIREBASE_WEBAPP_CONFIG is absent.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public reCAPTCHA Enterprise site key for App Check. Not a secret.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local App Check debug switch. Set to true only in development. Never set this in production.
NEXT_PUBLIC_APPCHECK_DEBUG=

# Server secrets. Secret Manager in production. Optional until the feature that reads them ships.
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, VRBO_ICAL_URL, ICAL_EXPORT_TOKEN, EMAIL_API_KEY are the five Secret Manager secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VRBO_ICAL_URL=
ICAL_EXPORT_TOKEN=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
APP_BASE_URL=
SCHEDULER_SA_EMAIL=
STORAGE_BUCKET=

# Emulator hosts, host:port with no scheme. Unset all three to use a real project through Application Default Credentials.
# Auth 127.0.0.1:9099, Firestore 127.0.0.1:8080, Storage 127.0.0.1:9199 when using the ports in firebase.json.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=
GCLOUD_PROJECT=
